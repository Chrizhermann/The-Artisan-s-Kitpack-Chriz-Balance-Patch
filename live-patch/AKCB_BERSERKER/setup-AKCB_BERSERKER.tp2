// AKCB_BERSERKER — live-install tail patch for the Artisan's Kitpack Berserker
// Overhaul rebalance (Chriz Balance Patch fork, docs/plans/2026-07-05-berserker-
// rebalance-design.md).
//
// This mod transforms an ALREADY-INSTALLED Artisan's Berserker Overhaul (#1003)
// into the rebalanced version, so it can be appended at the tail of a live WeiDU
// stack without uninstalling anything. Fresh installs should use the fork's
// lib/Berserker.tpa instead, which produces the same end state — with one
// accepted divergence: this patch keeps the installed Enrage-use grant levels
// (1,5,9,13,17,20,25,29,33,37,43,47) while the fork normalizes them to exactly
// every 4 levels (1,5,...,49). Functionally negligible (differs only at L20/21
// and L41+).

BACKUP ~AKCB_BERSERKER/backup~
AUTHOR ~Chriz (The Artisan's Kitpack — Chriz Balance Patch)~
VERSION ~2.0~

BEGIN ~Berserker Overhaul Rebalance: no self-harm, rage immunities, low-HP resistances, Hardiness restored~ DESIGNATED 0
REQUIRE_PREDICATE MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ 1003 ~This patch requires Artisan's Kitpack: Berserker Overhaul (component 1003).~

INCLUDE ~AKCB_BERSERKER/lib/kit_strref.tpa~

// ---------------------------------------------------------------------------
// In Extremis physical resistance — higher on Spell Revisions installs (SR's
// Revised Warrior HLAs nerfs Hardiness 40% physical -> 20% all types)
// ---------------------------------------------------------------------------
// v2.0: base per-tier resist; while Enraged it DOUBLES (equal-magnitude op326 delta
// gated on STATE_ENRAGED). Gated to L14+ headers (dual-class gate).
//   SR:      base 4/8/15   enraged 8/16/30
//   vanilla: base 3/6/10   enraged 6/12/20   (Hardiness is 40% not 20% here, so lower)
ACTION_IF MOD_IS_INSTALLED "spell_rev/setup-spell_rev.tp2" 0 BEGIN
  OUTER_SET ie_r1 = 4
  OUTER_SET ie_r2 = 8
  OUTER_SET ie_r3 = 15
END ELSE BEGIN
  OUTER_SET ie_r1 = 3
  OUTER_SET ie_r2 = 6
  OUTER_SET ie_r3 = 10
END

// ---------------------------------------------------------------------------
// Status immunities while Enraged, mirrored from the vanilla EE SPCL321
// implementation (opcode set + SCS detectable-spells states + display-string
// suppressions). Donor for cloning = the op328 STATE_ENRAGED marker (p2=104),
// which carries the right duration in both the 2-round package (c0ber#00, 12s)
// and the melee-hit refresh package (c0ber#09, 6s).
// v1.2: fear + morale failure moved HERE from the permanent passive (c0ber#07);
// confusion + feeblemind immunity dropped. Deliberately NOT immune: confusion,
// feeblemind, maze, imprisonment, level drain.
// ---------------------------------------------------------------------------
DEFINE_PATCH_FUNCTION akcb_rage_immunities BEGIN
  // op101 Immunity to opcode
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 45  special = 0 END // stun
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 210 special = 0 END // stun 90hp (Power Word: Stun)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 39  special = 0 END // sleep
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 217 special = 0 END // unconsciousness 20hp
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 175 special = 0 END // hold
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 109 special = 0 END // paralyze
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 5   special = 0 END // charm
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 24  special = 0 END // horror (fear)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 23  special = 0 END // morale
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 101 parameter1 = 0 parameter2 = 106 special = 0 END // morale break
  // op328 spell states so SCS AI knows not to waste disablers (SPLSTATE.IDS, engine-fixed)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 328 parameter1 = 0 parameter2 = 128 END // STUN_IMMUNITY
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 328 parameter1 = 0 parameter2 = 127 END // SLEEP_IMMUNITY
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 328 parameter1 = 0 parameter2 = 131 END // HOLD_IMMUNITY
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 328 parameter1 = 0 parameter2 = 119 END // CHARM_IMMUNITY
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 328 parameter1 = 0 parameter2 = 129 END // PANIC_IMMUNITY (as in spcl321)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 328 parameter1 = 0 parameter2 = 106 END // morale state (as in spcl321)
  // op296 protection from specific animation (charm/domination/fear visuals)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 296 parameter1 = 0 parameter2 = 5   special = 0 STR_VAR resource = spnwchrm END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 296 parameter1 = 0 parameter2 = 175 special = 0 STR_VAR resource = spmindat END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 296 parameter1 = 0 parameter2 = 175 special = 0 STR_VAR resource = spflayer END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 296 parameter1 = 0 parameter2 = 24  special = 0 STR_VAR resource = cdhorror END
  // op267 display-string suppression (BG2EE/EET strrefs, as in the EE-Fixpack-patched
  // SPCL321; without these, a blocked disabler still floats its "Stunned"/"Charmed" text).
  // NOTE: spcl321's level-drain string suppressions (41495/40968/40969/40979/41616) are
  // deliberately NOT copied — this rework grants no drain immunity, so drains must stay visible.
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 14043 parameter2 = 45  special = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 1280  parameter2 = 45  special = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 14001 parameter2 = 39  special = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 8364  parameter2 = 5   special = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 14780 parameter2 = 5   special = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 14672 parameter2 = 5   special = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 20568 parameter2 = 24  special = 0 END // "Morale Failure: Panic" (from c0ber#07)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 17427 parameter2 = 106 special = 0 END // "Panic" (as in spcl321)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 267 parameter1 = 14007 parameter2 = 106 special = 0 END // morale failure (as in spcl321)
  // op169 prevent portrait icon — a blocked disabler's separate op142 icon effect is NOT
  // stopped by op101 immunity to the disabler opcode; icon ids from statdesc.2da, set
  // mirrored from SPCL321 restricted to the granted categories
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 169 parameter1 = 0 parameter2 = 55  special = 0 END // Stun
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 169 parameter1 = 0 parameter2 = 14  special = 0 END // Sleep
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 169 parameter1 = 0 parameter2 = 130 special = 0 END // Unconscious
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 169 parameter1 = 0 parameter2 = 0   special = 0 END // Charm
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 169 parameter1 = 0 parameter2 = 1   special = 0 END // Dire Charm
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 169 parameter1 = 0 parameter2 = 43  special = 0 END // Domination
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 169 parameter1 = 0 parameter2 = 36  special = 0 END // Panic
  // fear/morale machinery moved from c0ber#07 (rage-bound since v1.2); one-shot
  // members (op240/op161/op321) fire at rage start, mirroring vanilla Enrage's fear cure
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 142 parameter1 = 0 parameter2 = 37 special = 0 END // Resist Fear icon
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 240 parameter1 = 0 parameter2 = 36 special = 0 END // remove active Panic icon
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 161 parameter1 = 0 parameter2 = 0  special = 0 END // cure fear
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 321 parameter1 = 0 parameter2 = 0  special = 0 STR_VAR resource = spwi205 END // dispel active Horror (wizard)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 321 parameter1 = 0 parameter2 = 0  special = 0 STR_VAR resource = spin105 END // dispel active Horror (innate)
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 23  parameter1 = 10 parameter2 = 1 special = 1 END // set morale to steady 10
  LPF CLONE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = 104 opcode = 106 parameter1 = 0  parameter2 = 1 special = 0 END // morale break -> 0
END

// WeiDU's built-in ALTER_EFFECT gates every field write on `parameter1 >= 0`
// (and PE integers are 32-bit, so unsigned-hex workarounds re-evaluate to
// negatives and are skipped too). This function writes a SIGNED parameter1 into
// every effect with the given opcode across all ability headers.
// SPL ability header: nFx at +0x1E, firstFxIdx at +0x20 (empirical layout;
// IESDP documents these wrong), effect stride 0x30, parameter1 at effect +0x04.
DEFINE_PATCH_FUNCTION akcb_alter_p1_signed
  INT_VAR match_op = 0
          new_p1 = 0
BEGIN
  READ_LONG  0x64 abil_off
  READ_SHORT 0x68 abil_num
  READ_LONG  0x6A fx_off
  FOR (i = 0; i < abil_num; ++i) BEGIN
    READ_SHORT (abil_off + i * 0x28 + 0x1E) nfx
    READ_SHORT (abil_off + i * 0x28 + 0x20) first
    FOR (j = 0; j < nfx; ++j) BEGIN
      READ_SHORT (fx_off + (first + j) * 0x30) op
      PATCH_IF op = match_op BEGIN
        WRITE_LONG (fx_off + (first + j) * 0x30 + 0x04) new_p1
      END
    END
  END
END

// v2.0: write a signed parameter1 into effects with the given opcode, but only in
// ability headers whose min-level (at +0x10) is in [min_lvl, max_lvl]. Enforces the
// level gates per-effect (e.g. resistance written into minlvl-14/20 headers, zeroed
// out of the minlvl-1/7/10 headers).
DEFINE_PATCH_FUNCTION akcb_set_p1_by_minlvl
  INT_VAR match_op = 0
          new_p1  = 0
          min_lvl = 0
          max_lvl = 9999
BEGIN
  READ_LONG  0x64 abil_off
  READ_SHORT 0x68 abil_num
  READ_LONG  0x6A fx_off
  FOR (i = 0; i < abil_num; ++i) BEGIN
    READ_SHORT (abil_off + i * 0x28 + 0x10) ml
    READ_SHORT (abil_off + i * 0x28 + 0x1E) nfx
    READ_SHORT (abil_off + i * 0x28 + 0x20) first
    PATCH_IF (ml >= min_lvl) AND (ml <= max_lvl) BEGIN
      FOR (j = 0; j < nfx; ++j) BEGIN
        READ_SHORT (fx_off + (first + j) * 0x30) op
        PATCH_IF op = match_op BEGIN
          WRITE_LONG (fx_off + (first + j) * 0x30 + 0x04) new_p1
        END
      END
    END
  END
END

// v2.0: ANTI-STACKING cleanup for the rage-scaling deltas. op326-applied effects are
// stamped with the SUB-SPELL resref (AKCBD*/AKCBR*) as their source, so the tier
// spells' existing op321 sweep (which removes C0BER#01/02/03) does NOT clear them.
// Without this, the 12s deltas re-applied every round steady-state to 2 concurrent
// copies -> the enraged bonus becomes ~3x base instead of the intended 2x. Prepend
// (insert_point=0) an op321 "remove by resource" for every delta resref so each round
// starts clean. Fields mirror the native C0BER#0* removals (p1=8, resist_dispel=2).
// Every tier removes ALL six so tier transitions (HP crossing a threshold) also clear
// the vacated tier's delta.
DEFINE_PATCH_FUNCTION akcb_add_delta_cleanup BEGIN
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 timing = 0 duration = 0 resist_dispel = 2 parameter1 = 8 parameter2 = 0 insert_point = 0 STR_VAR resource = ~AKCBD1~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 timing = 0 duration = 0 resist_dispel = 2 parameter1 = 8 parameter2 = 0 insert_point = 0 STR_VAR resource = ~AKCBD2~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 timing = 0 duration = 0 resist_dispel = 2 parameter1 = 8 parameter2 = 0 insert_point = 0 STR_VAR resource = ~AKCBD3~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 timing = 0 duration = 0 resist_dispel = 2 parameter1 = 8 parameter2 = 0 insert_point = 0 STR_VAR resource = ~AKCBR1~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 timing = 0 duration = 0 resist_dispel = 2 parameter1 = 8 parameter2 = 0 insert_point = 0 STR_VAR resource = ~AKCBR2~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 1 timing = 0 duration = 0 resist_dispel = 2 parameter1 = 8 parameter2 = 0 insert_point = 0 STR_VAR resource = ~AKCBR3~ END
END

// ---------------------------------------------------------------------------
// v2.0: ENRAGED-STATE CHECK for the rage-scaling op326 branch.
// STAT 0x112 = "is SPLSTATE index N set"; 104 = STATE_ENRAGED (set by Enrage while
// raging); RELATION 1 = is-set. op326 references this by row index (same convention
// op318 uses for C0CURHP). Appended at the tail so existing op326/op318 indices are
// unaffected; captured dynamically.
// ---------------------------------------------------------------------------
APPEND ~splprot.2da~ ~AKCBENR 0x112 104 1~ UNLESS ~AKCBENR~
COPY_EXISTING ~splprot.2da~ ~override~
  COUNT_2DA_COLS cols
  READ_2DA_ENTRIES_NOW rows cols
  FOR (row = 1; row < rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER rows row 0 ~stat~
    PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~AKCBENR~ BEGIN
      SET akcb_enr_row = %row%
    END
  END
BUT_ONLY

// ---------------------------------------------------------------------------
// v2.0: RAGE-SCALING DELTA SUB-SPELLS. While Enraged, In Extremis damage and physical
// resistance DOUBLE. Each tier carries an op326 "apply-if-enraged" branch pointing at
// one of these deltas; op326 re-evaluates every round (tiers are re-cast every round),
// so the bonus tracks rage cleanly. Delta magnitude equals the base (doubling).
// Built from the installed c0ber#1x shell (one header) with its op272 watcher stripped.
// ---------------------------------------------------------------------------
DEFINE_ACTION_FUNCTION akcb_make_dmg_delta INT_VAR dval = 0 STR_VAR res = ~~ BEGIN
  COPY_EXISTING ~c0ber#1x.spl~ ~override/%res%.spl~
    LPF DELETE_EFFECT INT_VAR match_opcode = 272 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 73  target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = dval probability1 = 100 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 286 target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = dval probability1 = 100 END
    LPF akcb_alter_p1_signed INT_VAR match_op = 286 new_p1 = (0 - dval) END // missile damage cancel
  BUT_ONLY
END
DEFINE_ACTION_FUNCTION akcb_make_resist_delta INT_VAR rval = 0 STR_VAR res = ~~ BEGIN
  COPY_EXISTING ~c0ber#1x.spl~ ~override/%res%.spl~
    LPF DELETE_EFFECT INT_VAR match_opcode = 272 END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 86 target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = rval probability1 = 100 END // slashing
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 87 target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = rval probability1 = 100 END // crushing
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 88 target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = rval probability1 = 100 END // piercing
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 89 target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = rval probability1 = 100 END // missile
  BUT_ONLY
END
LAF akcb_make_dmg_delta    INT_VAR dval = 1 STR_VAR res = ~AKCBD1~ END
LAF akcb_make_dmg_delta    INT_VAR dval = 2 STR_VAR res = ~AKCBD2~ END
LAF akcb_make_dmg_delta    INT_VAR dval = 4 STR_VAR res = ~AKCBD3~ END
LAF akcb_make_resist_delta INT_VAR rval = %ie_r1% STR_VAR res = ~AKCBR1~ END
LAF akcb_make_resist_delta INT_VAR rval = %ie_r2% STR_VAR res = ~AKCBR2~ END
LAF akcb_make_resist_delta INT_VAR rval = %ie_r3% STR_VAR res = ~AKCBR3~ END

// ---------------------------------------------------------------------------
// In Extremis tier spells (re-cast every round by the baked watchers, so these
// changes reach existing characters automatically). v2.0: THAC0 is now a penalty,
// resistance moves to L14+ headers (dual-class gate), APR moves to the L1 base,
// damage/resistance double while Enraged via the op326 branch.
// ---------------------------------------------------------------------------
COPY_EXISTING ~c0ber#01.spl~ ~override~
  // tier 1 (<76% HP) — v2.0: THAC0 -1 (penalty), dmg +1 (rage +2), AC -2,
  // resist %ie_r1%% GATED to L14+ (rage doubles), move +1 (L7+), saves +1 (L10+),
  // no APR, no luck.
  LPF DELETE_EFFECT INT_VAR match_opcode = 206 END
  LPF ALTER_EFFECT INT_VAR match_opcode = 126 parameter1 = 1 END // movement rider
  LPF ALTER_EFFECT INT_VAR match_opcode = 325 parameter1 = 1 END // saves rider
  LPF DELETE_EFFECT INT_VAR match_opcode = 1 END  // APR: none at tier 1
  LPF DELETE_EFFECT INT_VAR match_opcode = 22 END // luck: none at tier 1
  LPF akcb_alter_p1_signed INT_VAR match_op = 284 new_p1 = (0 - 1) END // melee THAC0 PENALTY
  LPF ALTER_EFFECT INT_VAR match_opcode = 73  parameter1 = 1 END // damage
  LPF akcb_alter_p1_signed INT_VAR match_op = 286 new_p1 = (0 - 1) END // missile damage cancel
  LPF akcb_alter_p1_signed INT_VAR match_op = 0   new_p1 = (0 - 2) END // AC penalty
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 86 parameter1 = %ie_r1% parameter2 = 0 END // slashing
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 87 parameter1 = %ie_r1% parameter2 = 0 END // crushing
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 88 parameter1 = %ie_r1% parameter2 = 0 END // piercing
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 89 parameter1 = %ie_r1% parameter2 = 0 END // missile
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 86 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 87 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 88 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 89 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  // rage-scaling op326: dmg delta all headers; resist delta L14+ headers (4,5) only
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 STR_VAR resource = ~AKCBD1~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 header = 4 STR_VAR resource = ~AKCBR1~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 header = 5 STR_VAR resource = ~AKCBR1~ END
  LPF akcb_add_delta_cleanup END // prepend op321 removals so the deltas don't stack across rounds
BUT_ONLY

COPY_EXISTING ~c0ber#02.spl~ ~override~
  // tier 2 (<50% HP) — v2.0: THAC0 -2 (penalty), dmg +2 (rage +4), AC -3,
  // resist %ie_r2%% (L14+, rage doubles), move +2 (L7+), saves +2 (L10+),
  // APR +1/2 moved to L1 (all headers), luck +1 (L20).
  LPF DELETE_EFFECT INT_VAR match_opcode = 206 END
  LPF akcb_alter_p1_signed INT_VAR match_op = 0 new_p1 = (0 - 3) END // AC penalty
  LPF ALTER_EFFECT INT_VAR match_opcode = 126 parameter1 = 2 END // movement rider
  LPF ALTER_EFFECT INT_VAR match_opcode = 325 parameter1 = 2 END // saves rider
  LPF ALTER_EFFECT INT_VAR match_opcode = 22  parameter1 = 1 END // luck rider (L20)
  // APR +1/2 relocated from L14 to L1 (all headers)
  LPF DELETE_EFFECT INT_VAR match_opcode = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 1 target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 6 probability1 = 100 END
  LPF akcb_alter_p1_signed INT_VAR match_op = 284 new_p1 = (0 - 2) END // melee THAC0 PENALTY
  LPF ALTER_EFFECT INT_VAR match_opcode = 73  parameter1 = 2 END // damage
  LPF akcb_alter_p1_signed INT_VAR match_op = 286 new_p1 = (0 - 2) END // missile damage cancel
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 86 parameter1 = %ie_r2% parameter2 = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 87 parameter1 = %ie_r2% parameter2 = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 88 parameter1 = %ie_r2% parameter2 = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 89 parameter1 = %ie_r2% parameter2 = 0 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 86 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 87 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 88 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 89 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 STR_VAR resource = ~AKCBD2~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 header = 4 STR_VAR resource = ~AKCBR2~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 header = 5 STR_VAR resource = ~AKCBR2~ END
  LPF akcb_add_delta_cleanup END // prepend op321 removals so the deltas don't stack across rounds
BUT_ONLY

COPY_EXISTING ~c0ber#03.spl~ ~override~
  // tier 3 (<26% HP) — v2.0: THAC0 -4 (penalty), dmg +4 (rage +8), AC -4,
  // resist %ie_r3%% (L14+, rage doubles), move +4 (L7+; also fixes upstream +10 op325
  // in the L10 header), saves +4 (L10+), APR +1 moved to L1 (all headers), luck +2 (L20).
  LPF DELETE_EFFECT INT_VAR match_opcode = 206 END
  LPF akcb_alter_p1_signed INT_VAR match_op = 284 new_p1 = (0 - 4) END // melee THAC0 PENALTY
  LPF ALTER_EFFECT  INT_VAR match_opcode = 73  parameter1 = 4 END // damage
  LPF akcb_alter_p1_signed INT_VAR match_op = 286 new_p1 = (0 - 4) END // missile damage cancel
  LPF akcb_alter_p1_signed INT_VAR match_op = 0   new_p1 = (0 - 4) END // AC penalty
  LPF ALTER_EFFECT  INT_VAR match_opcode = 325 parameter1 = 4 END // saves rider (L10+)
  LPF ALTER_EFFECT  INT_VAR match_opcode = 126 parameter1 = 4 END // movement rider (L7+)
  LPF ALTER_EFFECT  INT_VAR match_opcode = 22  parameter1 = 2 END // luck rider (L20)
  // APR +1 relocated from L14 to L1 (all headers)
  LPF DELETE_EFFECT INT_VAR match_opcode = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 1 target = 1 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 1 probability1 = 100 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 86 parameter1 = %ie_r3% parameter2 = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 87 parameter1 = %ie_r3% parameter2 = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 88 parameter1 = %ie_r3% parameter2 = 0 END
  LPF CLONE_EFFECT INT_VAR match_opcode = 73 opcode = 89 parameter1 = %ie_r3% parameter2 = 0 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 86 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 87 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 88 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF akcb_set_p1_by_minlvl INT_VAR match_op = 89 new_p1 = 0 min_lvl = 0 max_lvl = 13 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 STR_VAR resource = ~AKCBD3~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 header = 4 STR_VAR resource = ~AKCBR3~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 duration = 0 resist_dispel = 0 parameter1 = 0 parameter2 = %akcb_enr_row% probability1 = 100 header = 5 STR_VAR resource = ~AKCBR3~ END
  LPF akcb_add_delta_cleanup END // prepend op321 removals so the deltas don't stack across rounds
BUT_ONLY

// ---------------------------------------------------------------------------
// Enrage: drop the missing-HP damage ladder (20x op177), add status immunities.
// New description on c0ber#00.
// ---------------------------------------------------------------------------
COPY_EXISTING ~c0ber#00.spl~ ~override~
  LPF DELETE_EFFECT INT_VAR match_opcode = 177 END
  LPF akcb_rage_immunities END
SAY UNIDENTIFIED_DESC ~Enrage
The berserker taps into <PRO_HISHER> frenzy through sheer force of will. For the next two rounds, <PRO_HESHE> gains +15 maximum hit points and becomes immune to charm, fear, hold, morale failure, paralysis, sleep, and stun effects. If the remaining duration of Enrage is less than one round, melee attacks made by the berserker reset Enrage's duration to one round up to a maximum total duration of ten rounds. The berserker cannot cast spells while Enraged.~

COPY_EXISTING ~c0ber#09.spl~ ~override~
  // melee-hit refresh package — ladder out, immunities in (6s versions)
  LPF DELETE_EFFECT INT_VAR match_opcode = 177 END
  LPF akcb_rage_immunities END
BUT_ONLY

// Enrage cap engines: remove the 1 HP/second drain (op146 -> C0BER#04, timing 3)
// and the 20x op272 damage-ladder re-appliers. Leftover op321 cleanup references
// to C0BER#04/#6* stay as harmless no-ops.
COPY_EXISTING ~c0ber#08.spl~ ~override~
  LPF DELETE_EFFECT INT_VAR match_opcode = 146 match_timing = 3 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 272 END
BUT_ONLY

COPY_EXISTING ~c0ber#h2.spl~ ~override~
  LPF DELETE_EFFECT INT_VAR match_opcode = 146 match_timing = 3 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 272 END
BUT_ONLY

// ---------------------------------------------------------------------------
// v1.2: permanent passive (c0ber#07) keeps only the involuntary-berserk immunity
// (op101 vs 3, Berserk icon prevention) and the dwarven Battlerager title (op177).
// The fear/morale package moves into the Enrage packages (akcb_rage_immunities).
// New: Cavalier-style thrown-mode penalty (copied from c0cav01: op167 missile
// THAC0 -4, permanent) — covers melee/ranged hybrids (throwing axes/daggers) that
// the WEAPPROF ban below cannot touch without banning their melee use.
// NOTE for existing characters: c0ber#07's effects are BAKED into the save as
// timing-9 permanents — the updated AKCBRFRM cleanup spell strips and re-applies
// them (see bottom of this file).
// ---------------------------------------------------------------------------
COPY_EXISTING ~c0ber#07.spl~ ~override~
  LPF DELETE_EFFECT INT_VAR match_opcode = 296 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 267 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 321 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 142 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 240 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 161 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 23  END
  LPF DELETE_EFFECT INT_VAR match_opcode = 106 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 101 match_parameter2 = 23  END
  LPF DELETE_EFFECT INT_VAR match_opcode = 101 match_parameter2 = 24  END
  LPF DELETE_EFFECT INT_VAR match_opcode = 101 match_parameter2 = 106 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 169 match_parameter2 = 36  END
  // ADD_SPELL_EFFECT writes a positive placeholder; akcb_alter_p1_signed flips it
  // (negative parameter1 writes are silently dropped by the built-in functions)
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 167 target = 2 power = 0 parameter1 = 1 parameter2 = 0 timing = 9 duration = 0 probability1 = 100 resist_dispel = 2 END
  LPF akcb_alter_p1_signed INT_VAR match_op = 167 new_p1 = (0 - 4) END
BUT_ONLY

// ---------------------------------------------------------------------------
// v1.2: hard ranged-weapon ban — zero the BERSERKER column for the same
// WEAPPROF.2DA rows the Cavalier/Kensai/Dreadnought zero (the EE engine blocks
// equipping weapons whose kit proficiency cap is 0; this is exactly how AK's own
// ADD_KIT_EX kits implement "may not use ranged weapons"). Rows matched by label,
// BERSERKER column located dynamically from the header row (first token ID; data
// rows lead with the row label, hence header index + 1).
// ---------------------------------------------------------------------------
COPY_EXISTING ~weapprof.2da~ ~override~
  READ_2DA_ENTRIES_NOW akcb_rd_weapprof 1
  SET akcb_bercol = 0 - 1
  FOR (row = 0; row < akcb_rd_weapprof; ++row) BEGIN
    PATCH_IF akcb_bercol < 0 BEGIN
      READ_2DA_ENTRY_FORMER akcb_rd_weapprof row 0 ~akcb_tok~
      PATCH_IF ~%akcb_tok%~ STRING_EQUAL_CASE ~ID~ BEGIN // header row
        FOR (col = 1; (col < 500) AND (akcb_bercol < 0); ++col) BEGIN
          READ_2DA_ENTRY_FORMER akcb_rd_weapprof row col ~akcb_tok~
          PATCH_IF ~%akcb_tok%~ STRING_EQUAL_CASE ~BERSERKER~ BEGIN
            SET akcb_bercol = col + 1
          END
        END
      END
    END
  END
  PATCH_IF akcb_bercol < 0 BEGIN
    PATCH_FAIL ~AKCB: BERSERKER column not found in weapprof.2da~
  END
  SET akcb_wrote = 0
  FOR (row = 0; row < akcb_rd_weapprof; ++row) BEGIN
    READ_2DA_ENTRY_FORMER akcb_rd_weapprof row 0 ~akcb_tok~
    PATCH_IF (~%akcb_tok%~ STRING_EQUAL_CASE ~BOW_BG1~)
          OR (~%akcb_tok%~ STRING_EQUAL_CASE ~MISSILE_BG1~)
          OR (~%akcb_tok%~ STRING_EQUAL_CASE ~CROSSBOW~)
          OR (~%akcb_tok%~ STRING_EQUAL_CASE ~LONGBOW~)
          OR (~%akcb_tok%~ STRING_EQUAL_CASE ~SHORTBOW~)
          OR (~%akcb_tok%~ STRING_EQUAL_CASE ~DART~)
          OR (~%akcb_tok%~ STRING_EQUAL_CASE ~SLING~) BEGIN
      SET_2DA_ENTRY_LATER ~akcb_wr_weapprof~ row akcb_bercol ~0~
      SET akcb_wrote += 1
    END
  END
  PATCH_IF akcb_wrote > 0 BEGIN
    SET_2DA_ENTRIES_NOW ~akcb_wr_weapprof~ 1
  END ELSE BEGIN
    PATCH_FAIL ~AKCB: no ranged weapon rows found in weapprof.2da~
  END
BUT_ONLY

// ---------------------------------------------------------------------------
// CLAB: remove the Reckless Frenzy grant (GA_C0BER#05 at level 4). The Enrage-use
// grid is left as installed. Surgical edit — preserves the GA_C0FIG01/AP_C0FIG03
// rows added by the Fighter Overhaul.
// ---------------------------------------------------------------------------
COPY_EXISTING ~clabfi02.2da~ ~override~
  REPLACE_TEXTUALLY ~GA_C0BER#05~ ~****~
  PRETTY_PRINT_2DA
BUT_ONLY

// ---------------------------------------------------------------------------
// HLA table: restore Hardiness (GA_SPCL907) next to Extend Rage. The active
// table is resolved from luabbr.2da (SCS #4250 renamed AK's LUC0BER to Fi1 in
// this install); the orphaned LUC0BER.2DA is patched too for consistency.
// The row is written into the FIRST all-asterisk placeholder row — the layout
// every proven HLA-adder uses (AK's patch_add_hla, SCS's lightweight adder);
// no precedent exists for real rows after placeholder rows, so no APPEND.
// ---------------------------------------------------------------------------
DEFINE_ACTION_FUNCTION akcb_restore_hardiness
  STR_VAR table = ~~
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%table%.2da~ BEGIN
    COPY_EXISTING ~%table%.2da~ ~override~
      PATCH_IF (INDEX_BUFFER (~GA_SPCL907~) < 0) BEGIN
        READ_2DA_ENTRIES_NOW akcb_lu_rows 10
        SET akcb_done = 0
        FOR (row = 0; row < akcb_lu_rows; ++row) BEGIN
          PATCH_IF !akcb_done BEGIN
            READ_2DA_ENTRY_FORMER akcb_lu_rows row 1 ~abil~
            PATCH_IF ~%abil%~ STRING_EQUAL ~*~ BEGIN
              SET_2DA_ENTRY row 1 10 ~GA_SPCL907~ // ABILITY
              SET_2DA_ENTRY row 4 10 ~1~          // MIN_LEV
              SET_2DA_ENTRY row 5 10 ~99~         // MAX_LEVEL
              SET_2DA_ENTRY row 6 10 ~20~         // NUM_ALLOWED
              SET akcb_done = 1
            END
          END
        END
        PATCH_IF !akcb_done BEGIN
          // no placeholder row free — insert one at the end as a fallback
          INSERT_2DA_ROW akcb_lu_rows 10 ~40 GA_SPCL907 * * 1 99 20 * * *~
        END
        PRETTY_PRINT_2DA
      END
    BUT_ONLY
  END
END

OUTER_SPRINT akcb_hla_abbr ~~
COPY_EXISTING ~luabbr.2da~ ~override~
  COUNT_2DA_COLS cols
  READ_2DA_ENTRIES_NOW rows cols
  FOR (row = 1; row < rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER rows row 0 ~text~
    PATCH_IF ~%text%~ STRING_EQUAL_CASE ~BERSERKER~ BEGIN
      READ_2DA_ENTRY_FORMER rows row 1 ~akcb_hla_abbr~
      SPRINT ~akcb_hla_abbr~ ~%akcb_hla_abbr%~
    END
  END
BUT_ONLY

ACTION_IF (~%akcb_hla_abbr%~ STR_CMP ~~) BEGIN
  LAF akcb_restore_hardiness STR_VAR table = EVAL ~lu%akcb_hla_abbr%~ END
END

LAF akcb_restore_hardiness STR_VAR table = ~LUC0BER~ END

// ---------------------------------------------------------------------------
// Kit description (rewritten for the new mechanics)
// ---------------------------------------------------------------------------
OUTER_SPRINT kit_description ~BERSERKER: This is a warrior who is in tune with <PRO_HISHER> animalistic side and, during combat, can achieve an ecstatic state of mind that will enable <PRO_HIMHER> to fight longer, harder, and more savagely than any person has a right to. Berserkers tend to be barbarian-like in nature, but not always. Sometimes it is a conscious choice that a warrior in training makes. Regardless, opponents on the battlefield will be unsettled when they see the savage and inhuman elements of the Berserker's personality. This class is common amongst dwarves, known to them as the Battlerager.

Advantages:
– Immunity to involuntary berserk effects.
– Gains the In Extremis passive effect.

IN EXTREMIS: Berserkers revel in the thrill of carnage and fight harder — if wilder and more recklessly — as they approach death, where most warriors would falter or retreat. Their blows land with mounting force even as their swings grow erratic and their guard drops. While Enraged, this ferocity redoubles: the damage bonuses double.
  Below 75% Hit Points: -1 to hit, +1 melee damage (+2 while Enraged), -2 penalty to Armor Class
  Below 50% Hit Points: -2 to hit, +2 melee damage (+4 while Enraged), -3 penalty to Armor Class, +1/2 attack per round
  Below 25% Hit Points: -4 to hit, +4 melee damage (+8 while Enraged), -4 penalty to Armor Class, +1 attack per round

– May use the Enrage ability once per day. Gains one use at level 1 and an additional use every 4 levels thereafter.

ENRAGE: The berserker taps into <PRO_HISHER> frenzy through sheer force of will. For the next two rounds, <PRO_HESHE> gains +15 maximum hit points and becomes immune to charm, fear, hold, morale failure, paralysis, sleep, and stun effects. If the remaining duration of Enrage is less than one round, melee attacks made by the berserker reset Enrage's duration to one round up to a maximum total duration of ten rounds. The berserker cannot cast spells while Enraged.

– From 7th level onwards, the berserker gains +1/+2/+4 to <PRO_HISHER> movement rate while under the effects of In Extremis.

– From 10th level onwards, the berserker's trance-like state makes <PRO_HIMHER> more likely to shrug off debilitating effects, gaining +1/+2/+4 to all Saving Throws while under the effects of In Extremis.

– From 14th level onwards, the berserker's hide toughens under duress, granting %ie_r1%%/%ie_r2%%/%ie_r3%% resistance to physical damage at each successive wound tier while under the effects of In Extremis. These values double while Enraged.

– From 20th level onwards, the berserker gains a +1/+2 luck bonus to rolls on damage dealt and received while below 50% and 25% Hit Points respectively.

Disadvantages:
– Becomes winded for five rounds after using Enrage, suffering a -2 penalty to Armor Class, to-hit rolls, and damage rolls. Additionally, the berserker is unable to Enrage or gain the benefits of In Extremis while winded.
– May not use ranged weapons and incurs a -4 penalty to hit if wielding a melee/ranged weapon in ranged mode.KIT_DISADV_1
– Alignment restricted to any non-lawful.~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~1100~ THEN BEGIN
  OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
    REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~
– May not use Expertise or Rapid Shot.
– Does not gain Specialization in all weapons at 16th level.~
  END
END ELSE BEGIN
  OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
    REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~~
  END
END

LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~BERSERKER~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~%kit_description%~

// ---------------------------------------------------------------------------
// Cleanup spell for existing characters (v1.2). In application order:
//   1. op321 removes every save-baked effect sourced from C0BER#07 (the old
//      permanent passive's fear/morale package — op321 removes effects of any
//      timing mode, including timing-9 permanents)
//   2. op172 strips the already-granted Reckless Frenzy innate (known + memorized)
//   3. op146 instantly re-casts the NEW c0ber#07, re-baking the trimmed passive
//      (berserk immunity + dwarf title + op167 thrown-mode penalty)
// Run once in-game per berserker party member, e.g. for the protagonist:
//   C:Eval('ReallyForceSpellRES("AKCBRFRM",Player1)')
// (unquoted Player1 — a quoted "Player1" silently fails in C:Eval)
// Safe to re-run, and required again after upgrading from v1.0/v1.1.
// ---------------------------------------------------------------------------
COPY_EXISTING ~c0ber#06.spl~ ~override/akcbrfrm.spl~
  LPF ALTER_EFFECT INT_VAR match_opcode = 17 opcode = 172 parameter1 = 0 parameter2 = 0 STR_VAR resource = C0BER#05 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 2 power = 0 parameter1 = 0 parameter2 = 0 timing = 1 duration = 0 probability1 = 100 resist_dispel = 2 insert_point = 0 STR_VAR resource = C0BER#07 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 2 power = 0 parameter1 = 0 parameter2 = 1 timing = 1 duration = 0 probability1 = 100 resist_dispel = 2 STR_VAR resource = C0BER#07 END
BUT_ONLY
