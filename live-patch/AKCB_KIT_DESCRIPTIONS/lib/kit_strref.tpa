DEFINE_ACTION_FUNCTION ~GET_KIT_STRREF~
  STR_VAR kit_name = ~~
  RET kit_strref
BEGIN
  OUTER_SET kit_strref = 0 - 1
  ACTION_IF (STRING_LENGTH ~%kit_name%~ > 0) BEGIN
    COPY_EXISTING ~kitlist.2da~ ~override~
      COUNT_2DA_ROWS 5 num_rows
      FOR (row = 0; row < num_rows; row += 1) BEGIN
        READ_2DA_ENTRY row 1 5 kit
        PATCH_IF (~%kit%~ STRING_EQUAL_CASE ~%kit_name%~) BEGIN
          READ_2DA_ENTRY row 4 5 kit_strref
          SET row = num_rows
        END
      END
      BUT_ONLY

    // KITLIST uses legacy symbols that differ from the class-text row names.
    // Keep the original symbol as a match too, for tables supplied by mods.
    OUTER_SPRINT class_kit_name ~%kit_name%~
    ACTION_IF (~%kit_name%~ STRING_EQUAL_CASE ~ASSASIN~) BEGIN
      OUTER_SPRINT class_kit_name ~ASSASSIN~
    END ELSE ACTION_IF (~%kit_name%~ STRING_EQUAL_CASE ~FERALAN~) BEGIN
      OUTER_SPRINT class_kit_name ~ARCHER~
    END ELSE ACTION_IF (~%kit_name%~ STRING_EQUAL_CASE ~BEASTMASTER~) BEGIN
      OUTER_SPRINT class_kit_name ~BEAST_MASTER~
    END ELSE ACTION_IF (~%kit_name%~ STRING_EQUAL_CASE ~BEAST_FRIEND~) BEGIN
      OUTER_SPRINT class_kit_name ~AVENGER~
    END

    // A failed lookup must not blank out an existing class description.
    ACTION_IF (NOT IS_AN_INT ~%kit_strref%~) BEGIN
      OUTER_SET kit_strref = 0 - 1
    END
    ACTION_IF (kit_strref >= 0) BEGIN
      ACTION_FOR_EACH class_text IN BGCLATXT CLASTEXT SODCLTXT BEGIN
        ACTION_IF (FILE_EXISTS_IN_GAME ~%class_text%.2da~) BEGIN
          COPY_EXISTING ~%class_text%.2da~ ~override~
            COUNT_2DA_COLS cols
            READ_2DA_ENTRIES_NOW rows cols
            // With the full column count, row 0 is already the first data row.
            FOR (row = 0; row < rows; row += 1) BEGIN
              READ_2DA_ENTRY_FORMER rows row 0 text
              PATCH_IF ((~%text%~ STRING_EQUAL_CASE ~%kit_name%~) OR
                        (~%text%~ STRING_EQUAL_CASE ~%class_kit_name%~)) BEGIN
                READ_2DA_ENTRY_FORMER rows row 4 old_strref
                PATCH_IF (NOT (~%old_strref%~ STRING_EQUAL ~%kit_strref%~)) BEGIN
                  SET_2DA_ENTRY row 4 cols kit_strref
                END
              END
            END
            BUT_ONLY
        END
      END
    END
  END
END
