// Repair campaign description links for already-installed Artisan's Kitpack kits.
// Existing KITLIST HELP strings are authoritative; this component creates no
// strings and changes no kit abilities, character files, or saved games.

BACKUP ~AKCB_KIT_DESCRIPTIONS/backup~
AUTHOR ~Chriz (The Artisan's Kitpack - Chriz Balance Patch)~
VERSION ~1.0~

ALWAYS
  INCLUDE ~AKCB_KIT_DESCRIPTIONS/lib/kit_strref.tpa~
END

BEGIN ~Repair installed Artisan's Kitpack class descriptions~ DESIGNATED 0
REQUIRE_PREDICATE (GAME_IS ~bgee bg2ee eet~)
  ~This component requires Baldur's Gate: Enhanced Edition, BG2:EE, or EET.~

// Each pair is the KITLIST symbol and the component that writes its HELP text.
// Keep this mapping aligned with GET_KIT_STRREF callers in ArtisansKitpack.TP2.
// Both Dragon Disciple alternatives and both kits in Monk Revisions are covered.
ACTION_DEFINE_ASSOCIATIVE_ARRAY akcb_description_targets BEGIN
  ~BERSERKER~,        ~1003~  => 1
  ~WIZARD_SLAYER~,    ~1006~  => 1
  ~KENSAI~,           ~1004~  => 1
  ~BARBARIAN~,        ~1005~  => 1
  ~DWARVEN_DEFENDER~, ~1007~  => 1
  ~FERALAN~,          ~2010~  => 1
  ~STALKER~,          ~2011~  => 1
  ~BEASTMASTER~,      ~2012~  => 1
  ~CAVALIER~,         ~3010~  => 1
  ~INQUISITOR~,       ~3003~  => 1
  ~UNDEAD_HUNTER~,    ~3011~  => 1
  ~BLACKGUARD~,       ~3004~  => 1
  ~C0ILM~,            ~3005~  => 1
  ~TOTEMIC_DRUID~,    ~5300~  => 1
  ~SHAPESHIFTER~,     ~5100~  => 1
  ~BEAST_FRIEND~,     ~5200~  => 1
  ~C0HIVE~,           ~5002~  => 1
  ~ASSASIN~,          ~7004~  => 1
  ~BOUNTY_HUNTER~,    ~7007~  => 1
  ~SWASHBUCKLER~,     ~7006~  => 1
  ~SHADOWDANCER~,     ~7008~  => 1
  ~DRAGON_DISCIPLE~,  ~8002~  => 1
  ~DRAGON_DISCIPLE~,  ~8003~  => 1
  ~DARK_MOON~,        ~10001~ => 1
  ~SUN_SOUL~,         ~10001~ => 1
END

// Select targets before touching game resources. A kit installed by a different
// mod is not eligible unless its corresponding Artisan's component is installed.
ACTION_CLEAR_ARRAY akcb_installed_descriptions
OUTER_SET akcb_description_count = 0
ACTION_PHP_EACH akcb_description_targets AS target => unused BEGIN
  ACTION_IF (MOD_IS_INSTALLED ~ArtisansKitpack/ArtisansKitpack.TP2~ target_1) BEGIN
    OUTER_SET $akcb_installed_descriptions(~%target_0%~) = target_1
    OUTER_SET akcb_description_count += 1
  END
END

ACTION_IF (akcb_description_count = 0) BEGIN
  FAIL ~AKCB_KIT_DESCRIPTIONS: no supported Artisan's Kitpack kit components are installed.~
END

ACTION_PHP_EACH akcb_installed_descriptions AS kit_name => component BEGIN
  LAF GET_KIT_STRREF STR_VAR kit_name = EVAL ~%kit_name%~ RET kit_strref END
  ACTION_IF (kit_strref < 0) BEGIN
    FAIL ~AKCB_KIT_DESCRIPTIONS: component %component% is installed, but %kit_name% has no valid KITLIST HELP string. Repair the kit installation before applying this patch.~
  END
  PRINT ~AKCB_KIT_DESCRIPTIONS: %kit_name% campaign descriptions linked to existing string %kit_strref%.~
END

PRINT ~AKCB_KIT_DESCRIPTIONS: done. Fully restart the game to reload the class description tables.~
