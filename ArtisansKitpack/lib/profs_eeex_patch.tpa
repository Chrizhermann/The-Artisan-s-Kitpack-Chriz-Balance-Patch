BUT_ONLY

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~ //copies all item files
  PATCH_IF (SOURCE_SIZE > 0x71) BEGIN // avoid crashing on empty items
    READ_BYTE    0x20 thief //reads the byte containing the thief usability flag
    PATCH_IF ((thief BAND 0b01000000) = 0b00000000) BEGIN // if it is usable by thieves
      READ_BYTE    0x1F cthief //reads the byte containing cleric/thieves usability flag
      READ_SHORT    0x1C type //reads the byte containing item type
      PATCH_IF (type = 5) BEGIN // if it is arrows
        WRITE_BYTE    0x1F (thief BAND 0b11111101)  // makes usable by cleric/thieves
      END
    END
  END
BUT_ONLY_IF_IT_CHANGES

// C0PR#CL's class weapon grants, from WEAPPROF.2DA as it is now, with
// "apply C0PR#KG" moved back to the end and C0PR#KG rebuilt from every chain
// now in C0PR#XX, including chains that mods installed after Kitpack
// registered; then "AP_C0PR#CL" at every level of every class and kit
// ability table, including tables that such mods added or replaced
// (eeex/class_weapon_grants.tpa).
INCLUDE ~%MOD_FOLDER%/eeex/class_weapon_grants.tpa~
LAF c0_build_class_weapon_grants END
LAF c0_add_c0pr_cl_to_ability_tables END

// Katanas and other items that mods installed after the Invisible Blade or the
// Elementalist added, and kits such as the Dancer of Bardic Wonders, lose the
// Shapeshifter's bit where it only stands for the druid kits
// (lib/shapeshifter_kit_bit.tpa).
INCLUDE ~%MOD_FOLDER%/lib/shapeshifter_kit_bit.tpa~
LAF c0_free_borrowed_shapeshifter_bit END
