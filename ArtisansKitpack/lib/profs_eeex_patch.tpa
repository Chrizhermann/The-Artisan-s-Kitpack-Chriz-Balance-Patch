		LPF DELETE_EFFECT
			INT_VAR
				match_opcode = 319
				match_parameter1 = 11
				match_parameter2 = 5
		END
		LPF DELETE_EFFECT
			INT_VAR
				match_opcode = 319
        match_power = 0
				match_parameter1 = 21
				match_parameter2 = 5
		END
		END
    END
