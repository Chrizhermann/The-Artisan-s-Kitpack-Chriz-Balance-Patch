// Compatibility component: legacy Manyshot is retired. Runtime Aimed Shot
// automatically covers bows/crossbows added by later mods, without patching
// their ammunition, projectiles, animations, or ordinary equipped effects.
COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
  PATCH_IF (SOURCE_SIZE > 0x71) BEGIN
    FOR (akcb_manyshot_index = 1; akcb_manyshot_index <= 24; ++akcb_manyshot_index) BEGIN
      SPRINT akcb_manyshot_resource ~C0ARCP%akcb_manyshot_index%~
      PATCH_IF (akcb_manyshot_index < 10) BEGIN
        SPRINT akcb_manyshot_resource ~C0ARCP0%akcb_manyshot_index%~
      END
      LPF DELETE_EFFECT INT_VAR match_opcode = 177
        STR_VAR match_resource = EVAL ~%akcb_manyshot_resource%~ END
    END
  END
  BUT_ONLY
