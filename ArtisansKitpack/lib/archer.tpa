COPY ~%MOD_FOLDER%/Ranger/Archer/2DA~ ~OVERRIDE~
COPY ~%MOD_FOLDER%/Ranger/Archer/spells~ ~OVERRIDE~
COPY ~%MOD_FOLDER%/bmp~ ~OVERRIDE~

COPY_EXISTING ~CLABRN01.2DA~ ~OVERRIDE/CLABRN02.2DA~
	REPLACE_TEXTUALLY ~AP_C0RNH[%0-9%] ~ ~**** ~ // TOUGHNESS
	REPLACE_TEXTUALLY ~AP_C0RNH[%0-9%][%0-9%] ~ ~**** ~ // TOUGHNESS
	REPLACE_TEXTUALLY ~GA_SPCL311~ ~**** ~ // CHARM ANIMAL
	REPLACE_TEXTUALLY ~GA_SPCL412~ ~**** ~ // SET SNARE

	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = GA_C0ARC03 END
  	LPF set_clab_2da_entries INT_VAR f_MinLevel = 12 f_MaxLevel = 12 STR_VAR f_Entry = AP_C0ARC03Z END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0ARC00 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_Increment = 3 STR_VAR f_Entry = AP_C0ARC01 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 4 f_Increment = 4 STR_VAR f_Entry = GA_SPCL121 END

 	PRETTY_PRINT_2DA

COPY ~%MOD_FOLDER%/2DAs/HPARCH.2da~ ~OVERRIDE~

// CHRIZ BALANCE: Replace the old animation/projectile-based Manyshot entirely.
// No launcher gets extra projectiles; the late item component only cleans up
// legacy C0ARCP effects. The new opening-shot bonus is handled at firing time.
INCLUDE ~%MOD_FOLDER%/lib/archer-items.tpa~
INCLUDE ~%MOD_FOLDER%/lib/archer_first_shot.tpa~
INCLUDE ~%MOD_FOLDER%/lib/archer_called_shot.tpa~

// Normal visual range and critical chance. Keep unrelated kit restrictions
// and Rapid Shot cleanup in C0ARC00 intact at every level.
COPY_EXISTING ~C0ARC00.SPL~ ~override~
  LPF DELETE_EFFECT INT_VAR match_opcode = 262 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 272 STR_VAR match_resource = ~C0ARC00A~ END
  LPF DELETE_EFFECT INT_VAR match_opcode = 272 STR_VAR match_resource = ~C0ARC00B~ END

// Old saved triggers/innates must not recreate the removed benefits.
ACTION_FOR_EACH retired_archer_spell IN ~C0ARC00A~ ~C0ARC00B~ ~C0ARCH01~ BEGIN
  COPY_EXISTING ~%retired_archer_spell%.SPL~ ~override~
    LPF DELETE_EFFECT INT_VAR check_globals = 1 check_headers = 1 END
END

// The old HLA's stun helper is an EFF, not a spell. A zero-duration,
// zero-value AC modifier keeps it harmless if an old hit callback survives.
COPY_EXISTING ~C0ARCH1A.EFF~ ~override~
  WRITE_LONG 0x10 0
  WRITE_LONG 0x1c 0
  WRITE_LONG 0x20 0
  WRITE_LONG 0x24 0
  WRITE_LONG 0x28 0

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~2000~ THEN BEGIN
LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~FERALAN~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~ARCHER: The Archer is the epitome of skill with ranged weapons—the ultimate marks<PRO_MANWOMAN>, able to make almost any shot, no matter how difficult. Whether as a harrier launching a one-man fusillade of arrows or a sharpshooter hiding in the shadows waiting for the perfect shot, the archer is a master of all forms of marksmanship. To become so skilled with their art, the Archer has had to sacrifice some of <PRO_HISHER> proficiency with melee weapons and armor.

Advantages:
– +1 to hit rolls with ranged weapons. Gains an additional point at every 3rd level.
– May achieve Grand Mastery (5 slots) in longbows, shortbows and crossbows.
– May use the Rapid Shot modal ability.

RAPID SHOT: The archer may make an additional attack per round at a -4 penalty to hit.

– 4th level: May use the Called Shot ability once per day. Gains an additional use at every 4th level.

CALLED SHOT: For 10 seconds, successful ranged attacks reduce the target's movement rate by 25% for two rounds unless they save vs. Death. There is no saving throw penalty. Repeated applications refresh the duration instead of stacking. From 16th level, the Archer also gains +2 ranged weapon damage during Called Shot, regardless of the target's saving throw.

%akcb_archer_first_shot_description%
– 12th level: Improved Rapid Shot: The archer’s penalty to hit while Rapid Shot is active is reduced to -2.

Disadvantages:
– Hit Die: d8, does not gain Toughness bonus
– THAC0 penalty of -3 while wielding melee weapons.
– May only become Proficient (one slot) with melee weapons.
– May not gain Proficiency in Two-Weapon Style.
– May not Set Traps.
– May not use the Charm Animal ability.~
END
ACTION_IF NOT MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~2000~ THEN BEGIN
LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~FERALAN~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~ARCHER: The Archer is the epitome of skill with ranged weapons—the ultimate marks<PRO_MANWOMAN>, able to make almost any shot, no matter how difficult. Whether as a harrier launching a one-man fusillade of arrows or a sharpshooter hiding in the shadows waiting for the perfect shot, the archer is a master of all forms of marksmanship. To become so skilled with their art, the Archer has had to sacrifice some of <PRO_HISHER> proficiency with melee weapons and armor.

Advantages:
– +1 to hit rolls with ranged weapons. Gains an additional point at every 3rd level.
– May achieve Grand Mastery (5 slots) in longbows, shortbows and crossbows.
– May use the Rapid Shot modal ability.

RAPID SHOT: The archer may make an additional attack per round at a -4 penalty to hit.

– 4th level: May use the Called Shot ability once per day. Gains an additional use at every 4th level.

CALLED SHOT: For 10 seconds, successful ranged attacks reduce the target's movement rate by 25% for two rounds unless they save vs. Death. There is no saving throw penalty. Repeated applications refresh the duration instead of stacking. From 16th level, the Archer also gains +2 ranged weapon damage during Called Shot, regardless of the target's saving throw.

%akcb_archer_first_shot_description%
– 12th level: Improved Rapid Shot: The archer’s penalty to hit while Rapid Shot is active is reduced to -2.

Disadvantages:
– Hit Die: d8
– THAC0 penalty of -3 while wielding melee weapons.
– May only become Proficient (one slot) with melee weapons.
– May not gain Proficiency in Two-Weapon Style.
– May not use the Charm Animal ability.~
END
	
// ARCHER - HIT DIE
COPY_EXISTING ~hpclass.2da~ OVERRIDE
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 0; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~text~ // read column value
	  PATCH_IF ~%text%~ STRING_EQUAL_CASE ~FERALAN~ BEGIN
	    SET patch_row = %row%
		SET_2DA_ENTRY (%patch_row%) 1 cols ~HPARCH~
	  END
	END
	FOR (row = 0; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~text~ // read column value
	  PATCH_IF ~%text%~ STRING_EQUAL_CASE ~ARCHER~ BEGIN
	    SET patch_row = %row%
		SET_2DA_ENTRY (%patch_row%) 0 cols ~FERALAN~
		SET_2DA_ENTRY (%patch_row%) 1 cols ~HPARCH~
	  END
	END
  
// ARCHER - HLA
  COPY_EXISTING ~luabbr.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 0; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~text~ // read column value
	  PATCH_IF ~%text%~ STRING_EQUAL_CASE ~FERALAN~ BEGIN
	    SET patch_row = %row%
		SET_2DA_ENTRY (%patch_row%) 1 cols ~C0RA1~
	  END
	END

COPY_EXISTING ~LURA0.2da~ ~override/LUC0RA1.2DA~
// Retain the normal ranger HLA table, including Hardiness.
LPF patch_remove_hla STR_VAR remove_ability = ~GA_C0ARCH01~ END
	
// ARCHER - PROFICIENCIES
ACTION_CLEAR_ARRAY weapprof_cols_archer
        
COPY_EXISTING ~weapprof.2da~  ~override~
  COUNT_2DA_COLS col_count
  SET col_check = col_count - 1
  FOR (column = 0; column < col_check; ++column) BEGIN
    READ_2DA_ENTRY 0 column col_check name
    PATCH_IF (("FERALAN" STRING_COMPARE_CASE "%name%" = 0)) BEGIN
      SET column += 1 // row with names has an empty entry for the first column
      DEFINE_ASSOCIATIVE_ARRAY weapprof_cols_archer BEGIN ~%column%~ => ~%column%~ END
    END
  END
  PATCH_PHP_EACH weapprof_cols_archer AS column => foo BEGIN
    FOR (row = 8; row < 32; ++row) BEGIN
      READ_2DA_ENTRY row column col_count stars
      PATCH_IF (stars < 5) BEGIN
        SET_2DA_ENTRY 31 column col_count 0
      END
    END
  END
  PRETTY_PRINT_2DA
  BUT_ONLY
  
DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

INCLUDE ~%MOD_FOLDER%/spells/rapidshot.tpa~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~2000~ THEN BEGIN

ACTION_IF FILE_EXISTS_IN_GAME ~M_C0RAN1.lua~ THEN BEGIN

COPY_EXISTING ~thiefscl.2da~ ~override~
  REPLACE_TEXTUALLY ~^\([ %TAB%]*MAGE\)~ ~CD_DELETE_ME \1~ // adding column to header column
  COUNT_2DA_COLS col_count
  FOR (col = 1 ; col < col_count ; ++col) BEGIN
    READ_2DA_ENTRY 0 col col_count kit
    PATCH_IF ("%kit%" STRING_EQUAL_CASE "FERALAN") BEGIN
      READ_2DA_ENTRY 6 col col_count val
      SET_2DA_ENTRY  6 col col_count 100
      READ_2DA_ENTRY 3 col col_count val
      SET_2DA_ENTRY  3 col col_count 100
      SET col = col_count // kill loop
    END
  END  
  REPLACE_TEXTUALLY ~CD_DELETE_ME ~ ~~ // removing it
  PRETTY_PRINT_2DA
  BUT_ONLY
  
COPY_EXISTING ~clasiskl.2da~ ~override~
  REPLACE_TEXTUALLY ~^\([ %TAB%]*MAGE\)~ ~CD_DELETE_ME \1~ // adding column to header column
  COUNT_2DA_COLS col_count
  FOR (col = 1 ; col < col_count ; ++col) BEGIN
    READ_2DA_ENTRY 0 col col_count kit
    PATCH_IF ("%kit%" STRING_EQUAL_CASE "FERALAN") BEGIN
      READ_2DA_ENTRY 6 col col_count val
      SET_2DA_ENTRY  6 col col_count 20
      READ_2DA_ENTRY 3 col col_count val
      SET_2DA_ENTRY  3 col col_count 20
      SET col = col_count // kill loop
    END
  END  
  REPLACE_TEXTUALLY ~CD_DELETE_ME ~ ~~ // removing it
  PRETTY_PRINT_2DA
  BUT_ONLY
  
END
END
